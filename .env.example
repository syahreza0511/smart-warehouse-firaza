# Copy to .env.local and fill in. .env.local is ignored by Git.
#
# The app reads Supabase only from Route Handlers (server side), so these are
# not NEXT_PUBLIC_ variables. Use the project URL and the publishable (anon)
# key. Never put the service-role key in the application environment.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Auth cookies get the Secure attribute unless this is exactly "false".
# "false" is for local http://127.0.0.1 development and test runs only.
# On any HTTPS deployment leave it unset (or "true"); never copy "false"
# there. Unset or any other value means Secure.
AUTH_COOKIE_SECURE=false
